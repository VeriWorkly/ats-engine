# Copy to .env (gitignored) to run `npm run eval:live` against a real model. It makes about 15
# small, billed calls at the default 3 runs. Variables already set in the shell win over this file.
#
# Any OpenAI-compatible service (OpenAI, Gemini, OpenRouter, Groq, Ollama…): leave
# ATS_EVAL_PROVIDER unset, and set ATS_EVAL_BASE_URL for anything but OpenAI.
# Anthropic: ATS_EVAL_PROVIDER=anthropic.
ATS_EVAL_API_KEY=
ATS_EVAL_MODEL=
# ATS_EVAL_PROVIDER=anthropic
# ATS_EVAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Runs per case (default 3).
# ATS_EVAL_RUNS=3
# false to test without JSON Schema output (structured outputs are on by default here).
# ATS_EVAL_STRUCTURED=false
# A private AI policy JSON whose prompts replace the package defaults.
# ATS_EVAL_AI_POLICY=
