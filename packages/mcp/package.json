{
  "name": "@veriworkly/ats-engine-mcp",
  "version": "0.0.0",
  "description": "MCP server for @veriworkly/ats-engine: an AI assistant reads your resume the way an ATS does and scores it with a published, deterministic rubric. Runs locally.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ats",
    "resume",
    "cv",
    "job-match"
  ],
  "license": "MIT",
  "author": "Gautam Raj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeriWorkly/ats-engine.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/VeriWorkly/ats-engine/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/VeriWorkly/ats-engine/issues"
  },
  "mcpName": "io.github.veriworkly/ats-engine",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "ats-engine-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@veriworkly/ats-engine": "^0.1.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "zod": "^4.6.5"
  }
}
