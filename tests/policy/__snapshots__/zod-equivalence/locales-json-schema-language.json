        "other": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languageLevels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      }
    },
    "credentialWords": {
      "type": "object",
