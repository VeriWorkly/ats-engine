    "script": {
      "type": "string"
    },
    "detectionWords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defaultRegion": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    }
