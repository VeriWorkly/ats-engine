  "advice": {
    "file": {
      "genericNames": [
        "resume",
        "résumé",
        "resumé",
        "cv",
        "curriculum\\s*vitae",
        "cover\\s*letter",
        "my",
        "the",
        "and",
        "document\\d*",
        "doc\\d*",
        "untitled\\d*",
        "scan\\d*",
        "scanned",
        "img\\d*",
        "image\\d*",
        "file\\d*",
        "page\\d*"
      ],
      "draftMarks": [
        "final",
        "draft",
        "copy",
        "v\\d{1,3}",
        "ver\\d{1,3}",
        "version\\s?\\d{1,3}",
        "rev\\d{0,3}",
        "revised",
        "updated",
        "latest",
        "new",
        "old",
        "edited",
        "\\(\\d{1,3}\\)"
      ],
      "suggestedName": "{name}-Resume{ext}",
      "placeholderName": "Firstname-Lastname",
      "maxBytes": 2097152
    },
    "age": {
      "experiencePatterns": [
        "(?<!\\p{N})(\\d{1,2})\\s?\\+?\\s?(?:years?|yrs\\.?)['’]?\\s(?:of\\s)?(?:[\\p{L}-]{1,30}\\s){0,2}?experience"
      ]
    },
    "targets": {
      "greenhouse": {
        "name": "Greenhouse",
        "notes": [
          {
            "id": "parseSize",
            "message": "Greenhouse documents that it cannot parse a resume larger than 2.5 MB: the file is only attached, and its details are left to be typed in by hand.",
            "source": "https://support.greenhouse.io/hc/en-us/articles/200989175-Unsuccessful-resume-parse"
          },
          {
            "id": "layout",
            "message": "Greenhouse lists columns, tables, headers and footers, graphics, and a name or contact details in a header, footer or text box among the causes of a failed or partial parse.",
            "source": "https://support.greenhouse.io/hc/en-us/articles/200989175-Unsuccessful-resume-parse"
          },
          {
            "id": "fileTypes",
            "message": "Greenhouse accepts resumes as .pdf, .doc, .docx, .rtf or .txt.",
            "source": "https://support.greenhouse.io/hc/en-us/articles/360052218132-Supported-file-types-for-resumes-and-cover-letters"
          }
        ]
      },
      "lever": {
        "name": "Lever",
        "notes": [
          {
            "id": "images",
            "message": "Lever documents that it cannot parse a resume saved as an image (JPG, PNG), and suggests a test: if you cannot select the text in the file, it is likely not parseable.",
            "source": "https://help.lever.co/hc/en-us/articles/20087345054749-Understanding-Resume-Parsing"
          }
        ]
      },
      "taleo": {
        "name": "Oracle Taleo",
        "notes": [
          {
            "id": "fileTypes",
            "message": "In Oracle Taleo each employer's administrators choose which file formats candidates may attach, so use one the careers site offers; PDF, Word (.doc, .docx), RTF, HTML and plain text are among those Taleo supports.",
            "source": "https://docs.oracle.com/en/cloud/saas/taleo-enterprise/22d/otrcg/c-attachment.html"
          }
        ]
      }
    },
    "messages": {
      "fileName": {
        "message": "The file name does not say whose resume it is, or reads as a draft. Recruiters see it in the ATS and in their downloads, beside everyone else's.",
        "evidence": "The file is named \"{name}\".",
        "fix": "Name it {suggestion}."
      },
      "fileNameDraft": "The file is named \"{name}\", which reads as a draft: {marks}.",
      "fileSize": {
        "message": "The file is larger than {limit}. Many ATS upload forms and parsers stop at about that size; it is a common limit, not a universal one.",
        "evidence": "The file is {size}.",
        "fix": "Shrink or remove the images and export again; a resume of text alone is well under {limit}."
      },
      "passwordProtected": {
        "message": "The file is password-protected or encrypted. An ATS that cannot open it reads nothing, and some refuse an encrypted file even when it opens without a password.",
        "fix": "Save a copy with no password or security settings, and upload that."
      },
      "trackedChanges": {
        "message": "The document still holds tracked changes. A recruiter who opens it in Word sees the edits, and a parser may read deleted text as if it were there.",
        "evidence": "{n} tracked {n|change|changes} in the document.",
        "fix": "In Word, accept or reject every change (Review, Accept All Changes), turn Track Changes off, and save again."
      },
      "comments": {
        "message": "The document still holds comments. A recruiter who opens it in Word sees them.",
        "evidence": "{n} {n|comment|comments} in the document.",
        "fix": "In Word, delete them (Review, Delete All Comments in Document) and save again."
      },
      "graduationYear": {
        "message": "A graduation year more than {years} years back lets a reader work out your age, which can invite age bias. Leaving off graduation years older than about 15 years is common advice; the degree and the school are what a screen checks.",
        "evidence": "Education dated {dates}.",
        "fix": "Keep the degree and the school, and leave the year off."
      },
      "experienceYears": {
        "message": "More than {years} years of experience, stated or dated in full, lets a reader work out your age, which can invite age bias.",
        "evidence": "The resume says \"{phrase}\".",
        "fix": "Show the last 15 years or so in detail, sum up earlier roles in a line without dates, and write \"15+ years\" rather than the full count."
      },
      "experienceHistory": "{n} years of work history are dated."
    }
  },
